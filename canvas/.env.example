# Copy this file to .env at the repository root and fill it in.
# .env is ignored by git. Never commit a real token.

# The Canvas server to push to.
CANVAS_API_URL=http://192.168.4.100:3000

# Canvas > Account > Settings > New Access Token
CANVAS_API_TOKEN=

# The course to push into. Run push_to_canvas.py --test to list course IDs.
CANVAS_COURSE_ID=
